datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String
  role         String      @default("OFFICIAL") // "OFFICIAL" | "ADMIN"
  department   String?     // "Sanitation" | "Parks & Forestry" | "Water Utility" | "Public Works"
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  reports      Report[]
  workOrders   WorkOrder[]

  @@map("users")
}

model Report {
  id             String       @id @default(cuid())
  ref            String       @unique // "GW-XXXX"
  category       String       // "garbage" | "tree" | "water" | "plants" | "park" | "blocked"
  description    String
  address        String
  area           String
  lat            Float?
  lng            Float?
  priority       String       @default("Medium") // "High" | "Medium" | "Low"
  status         String       @default("New")    // "New" | "Verified" | "Assigned" | "In Progress" | "Resolved"
  department     String       // "Sanitation" | "Parks & Forestry" | "Water Utility" | "Public Works"
  assignee       String?      // Display name of official (e.g. "M. Alvarez")
  assignedUserId String?      @map("assigned_user_id")
  assignedUser   User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  workOrderRef   String?      @map("work_order_ref") // "WO-XXXX"
  dueDate        DateTime?    @map("due_date")
  resolvedAt     DateTime?    @map("resolved_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  photos         Photo[]
  ai             AiMetadata?
  activity       Activity[]
  workOrder      WorkOrder?

  @@index([category])
  @@index([status])
  @@index([priority])
  @@index([department])
  @@map("reports")
}

model Photo {
  id               String   @id @default(cuid())
  reportId         String   @map("report_id")
  report           Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  path             String   @default("")
  url              String
  thumbnailPath    String?  @map("thumbnail_path")
  thumbnailUrl     String?  @map("thumbnail_url")
  size             Int      @default(0)
  width            Int      @default(0)
  height           Int      @default(0)
  evidenceAnalysis Json?    @default("{}") @map("evidence_analysis")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([reportId])
  @@map("photos")
}

model AiMetadata {
  id           String   @id @default(cuid())
  reportId     String   @unique @map("report_id")
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  severity     String   // "High" | "Medium" | "Low"
  reason       String
  evidence     String   // "Good" | "Needs more info"
  confidence   Int      // 0 - 100
  similarCount Int      @default(0) @map("similar_count")
  similarIds   String   @default("[]") @map("similar_ids") // JSON array of string IDs
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("ai_metadata")
}

model Activity {
  id        String   @id @default(cuid())
  reportId  String   @map("report_id")
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind      String   // "agent" | "human"
  who       String   // e.g. "Triage Agent", "M. Alvarez", "You (Official)"
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([reportId])
  @@map("activities")
}

model WorkOrder {
  id             String    @id @default(cuid())
  ref            String    @unique // "WO-XXXX"
  reportId       String    @unique @map("report_id")
  report         Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  department     String
  status         String    @default("Pending") // "Pending" | "Dispatched" | "In Progress" | "Completed"
  assignedTo     String?   @map("assigned_to")
  assignedUserId String?   @map("assigned_user_id")
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  dueDate        DateTime? @map("due_date")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("work_orders")
}

model AgentRun {
  id             String   @id @default(cuid())
  reportId       String   @map("report_id")
  agentName      String   @map("agent_name")
  status         String   @default("completed") // "completed" | "fallback" | "failed"
  provider       String   @default("fallback")  // "gemini" | "fallback"
  fallbackReason String?  @map("fallback_reason")
  durationMs     Int      @default(0) @map("duration_ms")
  input          Json?
  output         Json?
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([reportId])
  @@map("agent_runs")
}
